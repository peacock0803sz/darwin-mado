{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>peacock0803sz/renovate-config"],
  "packageRules": [
    {
      // The go directive was deliberately lowered in 92e9667.
      // buildGoModule pins GOTOOLCHAIN=local, so a directive above the go
      // version shipped by nixpkgs makes `nix build` impossible.
      "description": "Do not bump the go directive in go.mod",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "enabled": false,
    },
  ],
}
